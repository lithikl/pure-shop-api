{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noirknull",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "NOIRKNULL_BUCKET",
      "bucket_name": "noirknull-prod"
    }
  ]

  // CUTOVER STEP:
  // Before the final production cutover, add:
  //
  // "workers_dev": false,
  // "routes": [
  //   {
  //     "pattern": "noirknull.in",
  //     "custom_domain": true
  //   }
  // ]
}
